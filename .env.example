# --- Base de datos (Postgres: Vercel Postgres o Neon) ---
# Base de datos SEPARADA de la de "APP LLAVEROS SAN AMARO" (colaboradores).
DATABASE_URL=

# --- Vercel Blob (fotos de perfil) ---
BLOB_READ_WRITE_TOKEN=

# --- Email transaccional (Resend) ---
RESEND_API_KEY=
# Remitente verificado en Resend. Si se omite: onboarding@resend.dev (solo pruebas).
EMAIL_FROM="Directorio de Profesionales San Amaro <no-reply@send.sanamaro.cl>"
# A dónde llegan las respuestas de quien recibe el correo.
EMAIL_REPLY_TO=administracion@sanamaro.cl

# --- Firma de tokens ---
# Verificación de correo y recuperación de contraseña. Mínimo 32 caracteres.
TOKEN_SECRET=
# Firma de la cookie de sesión del profesional. Mínimo 32 caracteres.
SESSION_SECRET=
# URL pública base de esta app (sin basePath). Ej: https://profesionales.sanamaro.cl
APP_URL=http://localhost:3000
