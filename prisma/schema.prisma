// Esquema de datos — Directorio de Profesionales, Grupo Educacional San Amaro.
// Ficha profesional autogestionada: cada profesional crea su cuenta, edita su
// propia ficha y decide cuándo publicarla. No hay panel de RR.HH. ni datos
// de institución — ver README.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profesional {
  id              String  @id @default(cuid()) // id_ficha — usado en la URL pública
  nombreCompleto  String
  email           String  @unique // solo para iniciar sesión — nunca se muestra en la ficha pública
  emailVerificado Boolean @default(false)
  passwordHash    String

  tituloProfesional         String  @default("")
  especializacion           String?
  numeroRegistroProfesional String?
  fotoUrl                   String?
  whatsapp                  String?
  correoContacto            String? // botón "Correo electrónico" de la ficha pública, distinto del correo de acceso
  direccionConsultorio      String?
  horariosAtencion          String?
  bio                       String?

  /// Botones de redes sociales de la ficha pública: [{ plataforma, url }]
  redesSociales Json?

  /// Combinación de color de la ficha pública. Ver src/lib/temas-ficha.ts
  /// para los valores reales de cada una — el enum solo fija qué opciones existen.
  temaFicha TemaFicha @default(PETROLEO)

  estadoPublicacion EstadoPublicacion @default(BORRADOR)

  tokens TokenAcceso[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estadoPublicacion])
}

/// Token de un solo uso para verificar correo o recuperar contraseña.
/// La firma JWT no basta por sí sola: esta tabla es la que permite
/// invalidarlo tras su primer uso o al emitir uno nuevo.
model TokenAcceso {
  id            String         @id @default(cuid())
  profesionalId String
  profesional   Profesional    @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  jti           String         @unique
  proposito     TokenProposito
  expiraEn      DateTime
  usadoEn       DateTime?
  creadoEn      DateTime       @default(now())

  @@index([profesionalId, proposito])
}

enum TokenProposito {
  VERIFICAR_CORREO
  RECUPERAR_CONTRASENA
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADA
}

enum TemaFicha {
  PETROLEO
  BURDEOS
  MARINO
  BOSQUE
  GRAFITO
  ROSADO
}
